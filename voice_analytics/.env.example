# Copy to .env and fill in. .env is gitignored.
#
# HF_TOKEN is REQUIRED: the pyannote models used for speaker overlap and customer
# isolation are GATED. A token alone is not enough - the terms must be accepted on
# each page, logged in as the account the token belongs to.
#
#   1. accept the terms on all three:
#        https://huggingface.co/pyannote/segmentation-3.0
#        https://huggingface.co/pyannote/speaker-diarization-3.1
#        https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
#   2. create a READ token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Comma-separated API keys for the HTTP service. Unset means the API is OPEN.
# Generate one with:  openssl rand -hex 24
VOICE_API_KEYS=
